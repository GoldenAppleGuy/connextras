{
  "manifest_version": 3,
  "name": "Connextras",
  "version": "1.0.0",
  "description": "Rearrange, color-tag and undo on NYT Connections, plus a puzzle clock, solve history with stats, and dark mode. Unofficial.",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "connextras@goldenappleguy",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.nytimes.com/games/connections*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/games/connections*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
